# Keep the build context small. This lives on a synced CloudStorage folder, so
# every file Docker reads crosses a FUSE mount - excluding what the images never
# use keeps "load build context" quick.
.git
.gitignore
.dockerignore

# Secrets: the images take configuration from the environment, never from a file.
.env
.env.local
.env.*.local

docs/
*.md

# Rust build output (the image builds its own)
backend/target/

# The Android app. Nothing in either image reads it, and its Gradle caches are
# large, numerous, and — on this FUSE mount — the thing most likely to be
# half-synced when a build runs. A stale handle under android/.gradle fails the
# whole context transfer, not just that file.
android/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Downloaded KNMI source data and ingestor output
*.h5
*.nc
frames/
manifest.json
grid.json
mqtt-client-id

.DS_Store
**/.DS_Store

# Nextcloud sync conflict copies. Keeping them out of the context matters more
# than the bytes: one that the FUSE mount could no longer read stalled a build.
* [0-9].*
*conflicted copy*
