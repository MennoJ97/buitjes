# KNMI Data Platform API key. Request a personal one (free) at:
#   https://developer.dataplatform.knmi.nl/open-data-api#token
#
# Use your OWN key, not the anonymous demo key from KNMI's docs: that one is
# shared by every anonymous user and is rate-limited hard enough that the
# ingestor spends most of its time backing off.
KNMI_API_KEY=your_knmi_api_key_here

# Source dataset. The default is KNMI's seamless precipitation ensemble: pySTEPS
# blending radar extrapolation with the HARMONIE-AROME ensemble, published every
# 5 minutes as 20 members x 72 steps (+5 min to +6 h) on a 1 km lat/lon grid.
#
# NOTE: this product is a KNMI pilot and could be changed or withdrawn. If it
# disappears, fall back to radar_forecast 2.0 (pySTEPS nowcast, +2 h only).
KNMI_DATASET=seamless_precipitation_ensemble_forecast_members
KNMI_VERSION=1.0

# --- optional, sensible defaults shown ---

# How the 20 ensemble members are reduced to one field: median, mean or max.
# Median is the robust central estimate; max shows the worst case any member has.
#ENSEMBLE_STAT=median

# --- discovering new files ---
#
# KNMI's documentation is explicit that repeatedly polling the Open Data API to
# check for new files counts as abuse of the platform. Two ways to behave:
#
# 1. (Best) Let KNMI push. Set a Notification Service key below and the ingestor
#    stops polling entirely, waiting on an MQTT subscription instead.
# 2. (Default) Scheduled polling: ask once per published file, at the moment it
#    is actually due, rather than on a blind fixed interval.
#
# Notification Service key. This is a SEPARATE credential from the Open Data
# key, requested from the same portal. Leave empty to use scheduled polling.
#KNMI_NOTIFICATION_API_KEY=
#MQTT_HOST=mqtt.dataplatform.knmi.nl
#MQTT_PORT=443
# Run a cycle anyway if the broker goes quiet this long (dead-connection guard).
#NOTIFICATION_IDLE_TIMEOUT=900

# Scheduled-polling parameters: how often the source publishes, and how long
# after a cycle's nominal time the file actually shows up. The ingestor waits
# until the next file is due instead of polling in between.
#SOURCE_INTERVAL_SECONDS=300
#PUBLISH_LAG_SECONDS=240
# Only used when a file is late or history is still backfilling.
#POLL_RETRY_SECONDS=60

# Restrict the output to part of the KNMI domain, as "west,south,east,north".
# The full domain is roughly -0.01,48.99,11.30,56.01 (about 30 KiB per frame,
# 1.4 MiB for a full cycle), so cropping is usually unnecessary.
#CROP_BOUNDS=1.0,49.5,9.5,55.0

# Full-scale rain rate for the 16-bit frame encoding. Values above this clip;
# the colour ramp already tops out at 100 mm/h.
#MAX_PRECIP_MM_H=100

# Lead time in minutes where the timeline stops labelling the blend a "nowcast".
# Presentation only - the underlying product is seamless.
#NOWCAST_MINUTES=120

# How many published cycles of frames to keep on disk. More than one so a
# browser still loading the previous manifest does not hit 404s.
#KEEP_CYCLES=3

# Seconds before /healthz reports the newest forecast as stale (server side).
#MAX_MANIFEST_AGE_SECONDS=1200

# --- observed history (the part of the timeline before "now") ---

# Real-time gauge-corrected radar composite. Unlike the forecast product this is
# a polar-stereographic KNMI HDF5 grid, reprojected onto the forecast's grid.
#KNMI_OBSERVED_DATASET=nl_rdr_data_rtcor_5m
#KNMI_OBSERVED_VERSION=1.0

# Minutes of past radar to show. Set to 0 to disable observed history entirely
# (the timeline then starts at "now" and the now-marker is hidden).
#HISTORY_MINUTES=60

# How many missing history frames to fetch per poll. Each one costs an API call
# to resolve its download URL, so history backfills over the first few cycles
# rather than in one burst that would trip KNMI's rate limiter. Raise this if
# you have a personal key and want history to fill in faster.
#OBSERVED_MAX_FETCH_PER_CYCLE=3

# --- point forecasts for the homepage widget ---

# Locations to publish, as "name:lat:lon" separated by semicolons. Each is
# served at /api/point/<name> as a precipitation line with ensemble spread
# (p10/p25/median/p75/p90) plus a probability-of-rain per step.
#
# Only these locations get uncertainty: the spread comes from sampling all 20
# KNMI ensemble members while the timestep is in memory during ingest. The
# map's click-to-inspect popup already covers arbitrary points, using the
# median frames it has already downloaded.
#WIDGET_LOCATIONS=home:52.3791:4.9003;office:51.9244:4.4777

# Temperature comes from Open-Meteo's ensemble endpoint so it gets a spread
# too. Set empty to publish precipitation only. This is the one external
# dependency in the pipeline, and it is best-effort: if it is unreachable the
# point forecast still goes out, without temperature.
#
# Why not KNMI? They do publish temperature with uncertainty - HARMONIE-AROME
# Cy43 EPS (harmonie_arome_cy43_p4a) - but it is a 5.5 GB tar of GRIB per
# hourly cycle, ~133 GB/day, to read a few numbers at one point. The
# deterministic NL version is still 817 MB/cycle and has no spread at all.
# Open-Meteo does expose KNMI's model (knmi_seamless) but only as a single
# deterministic series, so the spread has to come from another ensemble.
#
# Options, all with real members: icon_seamless (40, ~7 km over Europe, the
# default), icon_eu (40), ecmwf_ifs025 (51, coarser but strong global skill).
#TEMPERATURE_MODEL=icon_seamless
#TEMPERATURE_PAST_HOURS=2
#TEMPERATURE_FORECAST_HOURS=8
#TEMPERATURE_REFRESH_MINUTES=30
