# KNMI Data Platform API key. Request a personal one (free) at:
#   https://developer.dataplatform.knmi.nl/open-data-api#token
#
# Use your OWN key, not the anonymous demo key from KNMI's docs: that one is
# shared by every anonymous user and is rate-limited hard enough that the
# ingestor spends most of its time backing off.
KNMI_API_KEY=your_knmi_api_key_here

# Source dataset. The default is KNMI's seamless precipitation ensemble: pySTEPS
# blending radar extrapolation with the HARMONIE-AROME ensemble, published every
# 5 minutes as 20 members x 72 steps (+5 min to +6 h) on a 1 km lat/lon grid.
#
# NOTE: this product is a KNMI pilot and could be changed or withdrawn. If it
# disappears, fall back to radar_forecast 2.0 (pySTEPS nowcast, +2 h only).
KNMI_DATASET=seamless_precipitation_ensemble_forecast_members
KNMI_VERSION=1.0

# --- optional, sensible defaults shown ---

# How the 20 ensemble members are reduced to one field: median, mean or max.
# Median is the robust central estimate; max shows the worst case any member has.
#ENSEMBLE_STAT=median

# --- discovering new files ---
#
# KNMI's documentation is explicit that repeatedly polling the Open Data API to
# check for new files counts as abuse of the platform. Two ways to behave:
#
# 1. (Best) Let KNMI push. Set a Notification Service key below and the ingestor
#    stops polling entirely, waiting on an MQTT subscription instead.
# 2. (Default) Scheduled polling: ask once per published file, at the moment it
#    is actually due, rather than on a blind fixed interval.
#
# Notification Service key. This is a SEPARATE credential from the Open Data
# key, requested from the same portal. Leave empty to use scheduled polling.
#KNMI_NOTIFICATION_API_KEY=
#MQTT_HOST=mqtt.dataplatform.knmi.nl
#MQTT_PORT=443
# Run a cycle anyway if the broker goes quiet this long (dead-connection guard).
#NOTIFICATION_IDLE_TIMEOUT=900

# Scheduled-polling parameters: how often the source publishes, and how long
# after a cycle's nominal time the file actually shows up. The ingestor waits
# until the next file is due instead of polling in between.
#SOURCE_INTERVAL_SECONDS=300
#PUBLISH_LAG_SECONDS=240
# Only used when a file is late or history is still backfilling.
#POLL_RETRY_SECONDS=60

# Restrict the output to part of the KNMI domain, as "west,south,east,north".
# The full domain is roughly -0.01,48.99,11.30,56.01 (about 30 KiB per frame,
# 1.4 MiB for a full cycle), so cropping is usually unnecessary.
#CROP_BOUNDS=1.0,49.5,9.5,55.0

# Full-scale rain rate for the 16-bit frame encoding. Values above this clip;
# the colour ramp already tops out at 100 mm/h.
#MAX_PRECIP_MM_H=100

# Lead time in minutes where the timeline stops labelling the blend a "nowcast".
# Presentation only - the underlying product is seamless.
#NOWCAST_MINUTES=120

# How many published cycles of frames to keep on disk. More than one so a
# browser still loading the previous manifest does not hit 404s.
#KEEP_CYCLES=3

# Seconds before /healthz reports the newest forecast as stale (server side).
#MAX_MANIFEST_AGE_SECONDS=1200

# --- observed history (the part of the timeline before "now") ---

# Real-time gauge-corrected radar composite. Unlike the forecast product this is
# a polar-stereographic KNMI HDF5 grid, reprojected onto the forecast's grid.
#KNMI_OBSERVED_DATASET=nl_rdr_data_rtcor_5m
#KNMI_OBSERVED_VERSION=1.0

# Minutes of past radar to show. Set to 0 to disable observed history entirely
# (the timeline then starts at "now" and the now-marker is hidden).
#HISTORY_MINUTES=60

# How many missing history frames to fetch per poll. Each one costs an API call
# to resolve its download URL, so history backfills over the first few cycles
# rather than in one burst that would trip KNMI's rate limiter. Raise this if
# you have a personal key and want history to fill in faster.
#OBSERVED_MAX_FETCH_PER_CYCLE=3

# --- point forecasts for the homepage widget ---

# Locations to publish, as "name:lat:lon" separated by semicolons. Each is
# served at /api/point/<name> as a precipitation line with ensemble spread
# (p10/p25/median/p75/p90) plus a probability-of-rain per step.
#
# Only these locations get uncertainty: the spread comes from sampling all 20
# KNMI ensemble members while the timestep is in memory during ingest. The
# map's click-to-inspect popup already covers arbitrary points, using the
# median frames it has already downloaded.
#WIDGET_LOCATIONS=home:52.3791:4.9003;office:51.9244:4.4777

# Temperature, wind and solar come from Open-Meteo's ensemble endpoint so they
# get a spread too. Set empty to publish precipitation only. This is the one external
# dependency in the pipeline, and it is best-effort: if it is unreachable the
# point forecast still goes out, without temperature.
#
# Why not KNMI? They do publish temperature with uncertainty - HARMONIE-AROME
# Cy43 EPS (harmonie_arome_cy43_p4a) - but it is a 5.5 GB tar of GRIB per
# hourly cycle, ~133 GB/day, to read a few numbers at one point. The
# deterministic NL version is still 817 MB/cycle and has no spread at all.
# Open-Meteo does expose KNMI's model (knmi_seamless) but only as a single
# deterministic series, so the spread has to come from another ensemble.
#
# Options, all with real members: icon_seamless (40, ~7 km over Europe, the
# default), icon_eu (40), ecmwf_ifs025 (51, coarser but strong global skill).
#CONDITIONS_MODEL=icon_seamless
#CONDITIONS_PAST_HOURS=3
#CONDITIONS_FORECAST_HOURS=12
#CONDITIONS_REFRESH_MINUTES=30

# --------------------------------------------------------------- deployment
#
# Timezone for both containers. This one is load-bearing rather than cosmetic:
# alert bodies say "starting around 14:05", and that clock is the *container's*
# local time. Left unset the image runs on UTC, so a summer alert names a time
# two hours ago and reads like a notification that arrived late.
# Setting TZ is the fix; bind-mounting /etc/localtime is not.
#TZ=Europe/Amsterdam

# Server log verbosity. The default is our own lines at INFO and nothing from
# the libraries. Per-request logging sits at DEBUG on purpose: Traefik's access
# log already records every request in front of this, and one map page load is
# ~85 frame fetches, so repeating them here would bury the few lines that say
# something. Turn them on when you need them:
#   RUST_LOG=weather_backend=debug,tower_http=debug
#RUST_LOG=weather_backend=info,tower_http=warn

# The hostname Traefik routes to the app. TLS is assumed to be configured on the
# `websecure` entrypoint (a wildcard certificate covering this name); a Traefik
# that issues per-router certificates needs a certresolver label adding.
#BUITJES_HOST=weather.example.nl

# The router's middleware chain, in order. Traefik *replaces* the list rather
# than appending to it, so every middleware the router should have — including
# the rate limiter defined in docker-compose.yml — has to be named here.
#
#   buitjes-ratelimit@docker                     open to the internet
#   sso-auth@docker,buitjes-ratelimit@docker    behind SSO
#   internal-only@docker,buitjes-ratelimit@docker     LAN and VPN only
#
# Auth first, so an unauthenticated visitor is turned away before the app is
# asked for anything. Note that putting this behind SSO also gates the *API*:
# a browser widget on another origin would then get a login page instead of
# JSON, while a dashboard fetching the container directly over the Docker
# network is unaffected — see the CORS note below.
#BUITJES_MIDDLEWARES=buitjes-ratelimit@docker

# --- exposing this on the public internet ---
#
# Be clear-eyed about what each layer does:
#
#   CORS          stops *other websites'* JavaScript from reading your API in a
#                 visitor's browser. It does nothing against curl or a script.
#   API_KEYS      stops casual scraping and lets you revoke access. A key shipped
#                 inside a public homepage widget is readable by anyone who opens
#                 devtools, so treat it as an identifier, not a password.
#   rate limiting is the layer that actually protects the machine. It lives in
#                 Traefik (see the labels in docker-compose.yml) so it applies
#                 before a request reaches the container, and covers the static
#                 frontend and the frame downloads too.
#   volumetric    a real flood saturates the uplink before any of the above sees
#     DDoS        it. That can only be handled upstream - your hosting provider's
#                 protection, or putting a CDN in front of the domain.
#
# Origins allowed to call the API cross-origin. Unset = same-origin only, which
# is the safe default. "*" restores the old allow-everything behaviour.
#CORS_ALLOWED_ORIGINS=https://home.example.nl

# Comma-separated keys accepted on the widget endpoints, via an X-API-Key header
# or a ?key= query parameter. Empty leaves them open. Listing two lets you roll
# a new key onto the widget before removing the old one.
#   openssl rand -hex 24
#API_KEYS=

# Whatever you set here also gates the *list of saved locations*. /api/config
# stays open, because the map needs its bounds and frame list to draw anything,
# but the `points` array — the names and coordinates from WIDGET_LOCATIONS — is
# served only to a caller presenting a key. The location picker on the forecast
# page appears only for that reader; open it once as
#   https://your.host/forecast.html?key=<one of API_KEYS>
# and the browser remembers the key, stripping it back out of the address bar.
# With API_KEYS empty there is nothing to tell callers apart by, so the manifest
# is served whole — a private single-user setup should not need to invent a key.

# Which paths the key guards. The default covers the widget endpoints only: the
# map's own page needs /api/config and /api/frames, and a key embedded in a
# public page protects nothing anyway. Set to "/api" to lock everything down and
# accept that the browser map then needs a key too.
#API_KEY_PROTECTED_PREFIXES=/api/point,/api/current

# ----------------------------------------------------------------- alerts
#
# "Tell me when it is about to rain at X." Evaluated in the ingestor each time a
# cycle is published, against the same point forecast the API serves — so a rule
# can only watch a location listed in WIDGET_LOCATIONS above.
#
#   name : threshold_mm_h : lead_minutes [: probability [: quiet_minutes]]
#
# separated by semicolons. Every field after the name may be left empty to take
# its default (0.5 mm/h, 60 minutes, no probability floor, 60 minutes quiet).
#
#   ALERT_RULES=home                 rain over 0.5 mm/h within the hour
#   ALERT_RULES=home:2:30            only heavier rain, half an hour ahead
#   ALERT_RULES=home:0.5:60:0.6      and only if 60% of members agree
#   ALERT_RULES=home:1:60; work:1:90 two locations, different lead times
#
# An alert fires on the *edge* — rain entering the window — and then stays quiet
# until the window is clearly dry again. See ingestor/alerts.py for why that
# needs three separate mechanisms rather than one.
#ALERT_RULES=

# Where alerts are delivered. A plain webhook, because ntfy, Gotify, Home
# Assistant, Discord and a two-line script all accept one:
#   ntfy      https://ntfy.sh/your-topic          with ALERT_FORMAT=ntfy
#   self-hosted ntfy on the same Docker network: http://ntfy/<topic>. Prefer
#     that over the public hostname — going out and back in sends the alert
#     through your own reverse proxy and whatever WAF sits on it, and a WAF
#     that inspects JSON request bodies can ban the host for talking to itself.
#     ALERT_FORMAT=ntfy also avoids sending a JSON body at all.
#   Gotify    https://gotify.example.nl/message?token=...
#   anything  receives {title, message, location, onset, peak_mm_h, ...}
# Rules without a webhook are still evaluated and logged, which is a useful dry
# run and useless as an alarm.
#ALERT_WEBHOOK_URL=
#ALERT_FORMAT=json
# Sent as the Authorization header — e.g. an ntfy access token.
#ALERT_WEBHOOK_AUTH=Bearer tk_...

# Where the latch state lives. Defaults to alerts.json beside the frames, so a
# restart does not re-announce rain it already announced.
#ALERT_STATE_FILE=/data/alerts.json
