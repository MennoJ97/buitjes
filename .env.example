# KNMI Data Platform API key. Request a personal one (free) at:
#   https://developer.dataplatform.knmi.nl/open-data-api#token
#
# Use your OWN key, not the anonymous demo key from KNMI's docs: that one is
# shared by every anonymous user and is rate-limited hard enough that the
# ingestor spends most of its time backing off.
KNMI_API_KEY=your_knmi_api_key_here

# Source dataset. The default is KNMI's seamless precipitation ensemble: pySTEPS
# blending radar extrapolation with the HARMONIE-AROME ensemble, published every
# 5 minutes as 20 members x 72 steps (+5 min to +6 h) on a 1 km lat/lon grid.
#
# NOTE: this product is a KNMI pilot and could be changed or withdrawn. If it
# disappears, fall back to radar_forecast 2.0 (pySTEPS nowcast, +2 h only).
KNMI_DATASET=seamless_precipitation_ensemble_forecast_members
KNMI_VERSION=1.0

# --- optional, sensible defaults shown ---

# How the 20 ensemble members are reduced to one field for the map: pmm,
# median, mean or max.
#
# pmm is the probability-matched mean, and it is the default because the obvious
# answers are both wrong in the same direction. Members disagree about where a
# shower will be long before they disagree about whether it will happen, so
# averaging them spreads one shower's water across all of their guesses: the
# mean is too wide and peaks at a fraction of what any member forecast. The
# median is worse — it is dry wherever fewer than half the members rain on that
# exact square kilometre, so it loses a quarter of the ensemble's water at
# short range and more than half of it by +6 h.
#
# pmm keeps the mean's placement and re-fits the intensities to the ensemble's
# own distribution, so wet area and peak rates come out like a real member's
# while the position stays the average of all twenty. It costs about a second
# per cycle. See ingestor/blend.py.
#
# median, mean and max remain available. max is the only one of them worth
# choosing on purpose: it answers "what is the worst any member sees here".
#ENSEMBLE_STAT=pmm

# --- discovering new files ---
#
# KNMI's documentation is explicit that repeatedly polling the Open Data API to
# check for new files counts as abuse of the platform. Two ways to behave:
#
# 1. (Best) Let KNMI push. Set a Notification Service key below and the ingestor
#    stops polling entirely, waiting on an MQTT subscription instead.
# 2. (Default) Scheduled polling: ask once per published file, at the moment it
#    is actually due, rather than on a blind fixed interval.
#
# Notification Service key. This is a SEPARATE credential from the Open Data
# key, requested from the same portal. Leave empty to use scheduled polling.
#KNMI_NOTIFICATION_API_KEY=
#MQTT_HOST=mqtt.dataplatform.knmi.nl
#MQTT_PORT=443
# Run a cycle anyway if the broker goes quiet this long (dead-connection guard).
#NOTIFICATION_IDLE_TIMEOUT=900

# Scheduled-polling parameters: how often the source publishes, and how long
# after a cycle's nominal time the file actually shows up. The ingestor waits
# until the next file is due instead of polling in between.
#SOURCE_INTERVAL_SECONDS=300
#PUBLISH_LAG_SECONDS=240
# Only used when a file is late or history is still backfilling.
#POLL_RETRY_SECONDS=60

# Restrict the output to part of the KNMI domain, as "west,south,east,north".
# The full domain is roughly -0.01,48.99,11.30,56.01 - the English coast to
# Poland - at 780x780. That is not the cheap default it once looked: measured
# on a real cycle it is about 97 KiB per rain frame and 149 KiB per spread
# frame, ~18 MiB and ~35 CPU-seconds for a full cycle. (An older note here said
# 30 KiB and 1.4 MiB, which predates both the spread layer and the present
# grid.) Cropping scales the encode and the reduction with the pixel count, so
# it is worth doing if the map only ever gets looked at over one country.
# Note that SPREAD_RADIUS_KM's dilation still runs on the uncropped grid, so a
# crop saves less than the pixel ratio suggests until that is changed too.
#CROP_BOUNDS=1.0,49.5,9.5,55.0

# Full-scale rain rate for the 16-bit frame encoding. Values above this clip;
# the colour ramp already tops out at 100 mm/h.
#MAX_PRECIP_MM_H=100

# Lead time in minutes where the timeline stops labelling the blend a "nowcast".
# Presentation only - the underlying product is seamless.
#NOWCAST_MINUTES=120

# How far out every published timestep gets a frame of its own, and how far
# apart the frames are after that. KNMI publishes 72 five-minute steps to +6 h,
# and the last two hours of those were half the bytes and most of the CPU of a
# cycle - while a five-minute cadence four hours out is a precision the blend
# does not have that far ahead, where it is essentially the hourly HARMONIE
# ensemble. The defaults publish 48 steps instead of 72: every five minutes to
# +2 h, then every ten.
#
# This thins the point forecasts and the chart beyond the window as well as the
# map frames, because they are all built from the same pass over the members.
# Alert rules with a lead time inside the window are unaffected. Set
# TAIL_STEP_MINUTES=0 to publish every step KNMI sends, as before.
#FULL_CADENCE_MINUTES=120
#TAIL_STEP_MINUTES=10

# How many published cycles of frames to keep on disk. More than one so a
# browser still loading the previous manifest does not hit 404s.
#KEEP_CYCLES=3

# Seconds before /healthz reports the newest forecast as stale (server side).
#MAX_MANIFEST_AGE_SECONDS=1200

# --- observed history (the part of the timeline before "now") ---

# Real-time gauge-corrected radar composite. Unlike the forecast product this is
# a polar-stereographic KNMI HDF5 grid, reprojected onto the forecast's grid.
#KNMI_OBSERVED_DATASET=nl_rdr_data_rtcor_5m
#KNMI_OBSERVED_VERSION=1.0

# Minutes of past radar to show. Set to 0 to disable observed history entirely
# (the timeline then starts at "now" and the now-marker is hidden).
#HISTORY_MINUTES=60

# How many missing history frames to fetch per poll. Each one costs an API call
# to resolve its download URL, so history backfills over the first few cycles
# rather than in one burst that would trip KNMI's rate limiter. Raise this if
# you have a personal key and want history to fill in faster.
#OBSERVED_MAX_FETCH_PER_CYCLE=3

# --- point forecasts for the homepage widget ---

# Locations to publish, as "name:lat:lon" separated by semicolons. Each is
# served at /api/point/<name> as a precipitation line with ensemble spread
# (p10/p25/median/p75/p90) plus a probability-of-rain per step.
#
# Only these locations get uncertainty: the spread comes from sampling all 20
# KNMI ensemble members while the timestep is in memory during ingest. The
# map's click-to-inspect popup already covers arbitrary points, using the
# frames it has already downloaded.
#WIDGET_LOCATIONS=home:52.3791:4.9003;office:51.9244:4.4777

# Radius for the neighbourhood probability of rain, in kilometres.
#
# Each published step carries two probabilities. `probability` counts the
# members raining on the location's own square kilometre; `probability_nearby`
# counts the members raining anywhere within this radius. The second is usually
# the one a reader means. Twenty members can agree completely that a shower is
# coming and still each put it in a slightly different place, which drives the
# first number down for a shower nobody doubts — so a low `probability` says
# the members disagree about position, not that it will stay dry.
#
# Ten kilometres is the usual choice for a convective-scale ensemble. Smaller
# is stricter about "on me"; larger shades into "somewhere in the region".
#NEIGHBOURHOOD_KM=10

# Radius for the map's spread layer, in kilometres. Blank switches it off.
#
# Alongside each rain frame the ingestor publishes a second one carrying p10,
# p50 and p90 of the ensemble — a band for every pixel, not only for the
# configured locations. What it is a band *of* depends on this radius, and the
# choice is not cosmetic.
#
# At zero it is the percentiles of each square kilometre on its own, and for
# showers that is dominated by the members disagreeing about *where* rather than
# whether: on 60% of the pixels the map paints rain, such a band has its lower
# edge sitting on zero, so it can say "up to" and never "at least". Taking each
# member's maximum over a small neighbourhood first turns position disagreement
# into a spatial tolerance, and the band starts carrying information in both
# directions.
#
# Wider is not simply better. Dilation lifts the whole band, floor included, so
# past a point the band climbs off the field it is meant to describe. Measured
# over one cycle — the share of painted pixels whose value falls inside the
# band, against the share whose lower edge is stuck at dry:
#
#   radius     value inside band    lower edge dry    band width
#   0 (cell)              94.0%             60.2%      3.1 mm/h
#   3 km                  90.6%             42.6%      4.9 mm/h
#   10 km                 82.6%             25.2%      7.5 mm/h
#   20 km                 66.3%             13.0%     11.0 mm/h
#
# Three kilometres keeps the band around the field it accompanies and still
# lifts a third of the floor off dry. Ten matches NEIGHBOURHOOD_KM above, which
# makes the map and the point forecasts the same claim, at the cost of the band
# no longer containing the drawn value one time in six.
#
# Costs about 1.3x the rain frames on disk, and roughly 30 s of the ingest cycle
# — which is why it is a separate file: a reader who never opens the layer never
# downloads it.
#SPREAD_RADIUS_KM=3

# How much coarser the spread frames are than the rain frames. The band is a
# deliberately smoothed statistic - "how hard could it rain within
# SPREAD_RADIUS_KM of here" - so drawing it at the rain layer's own 1 km is
# finer than the quantity means, and at full resolution it was about half the
# cost of a cycle: the dilation over a whole member stack, then a lossless WebP
# of three busy channels. At 2 the spread layer costs a quarter of the compute
# and about a fifth of the bytes.
#
# The radius is honoured whatever this is set to. The reach is recomputed
# against the pooled grid *counting the pooling block*, which is itself a
# dilation - a reach taken from the coarser cell size alone spends that block
# twice and covers 5 km for a 3 km setting. 1 restores full resolution.
#
# Note the published band changes slightly: on KNMI's grid the full-resolution
# reach rounds up to 3.0 x 3.9 km for a 3 km radius, where the pooled one
# covers 3.0 x 2.95 km, so the band comes out around a tenth narrower - the
# east-west over-reach going away, not the pooling losing anything.
#SPREAD_DOWNSAMPLE=2

# Temperature, wind and solar come from Open-Meteo's ensemble endpoint so they
# get a spread too. Set empty to publish precipitation only. This is the one external
# dependency in the pipeline, and it is best-effort: if it is unreachable the
# point forecast still goes out, without temperature.
#
# Why not KNMI? They do publish temperature with uncertainty - HARMONIE-AROME
# Cy43 EPS (harmonie_arome_cy43_p4a) - but it is a 5.5 GB tar of GRIB per
# hourly cycle, ~133 GB/day, to read a few numbers at one point. The
# deterministic NL version is still 817 MB/cycle and has no spread at all.
# Open-Meteo does expose KNMI's model (knmi_seamless) but only as a single
# deterministic series, so the spread has to come from another ensemble.
#
# Options, all with real members: icon_seamless (40, ~7 km over Europe, the
# default), icon_eu (40), ecmwf_ifs025 (51, coarser but strong global skill).
#CONDITIONS_MODEL=icon_seamless
#CONDITIONS_PAST_HOURS=3
#CONDITIONS_FORECAST_HOURS=12
#CONDITIONS_REFRESH_MINUTES=30

# How much of Open-Meteo's quota the server may spend answering map clicks.
#
# The ingestor's own use is fixed and tiny - one call per configured location
# per refresh. /api/conditions is the open-ended one: it fetches on demand for
# whatever coordinate a visitor clicks, and only a cache miss costs anything.
# This is a single bucket shared by every caller, because the quota being
# protected is shared too; the per-IP limit in front of the endpoint (see the
# Traefik labels in docker-compose.yml) is the other half of the pair.
#
# The defaults hold 60 calls and refill 3 a minute, so a burst of clicking is
# never noticed and a sustained sweep settles at ~4.3k calls/day - well inside
# the free tier's ~10k. When the bucket is empty the endpoint answers 503 with
# a Retry-After instead of calling upstream. Requests for coordinates outside
# the published bounds are refused before any of this, so the set of
# coordinates that can spend a token is finite.
#CONDITIONS_UPSTREAM_BURST=60
#CONDITIONS_UPSTREAM_PER_MINUTE=3

# --------------------------------------------------------------- deployment
#
# Timezone for both containers. This one is load-bearing rather than cosmetic:
# alert bodies say "starting around 14:05", and that clock is the *container's*
# local time. Left unset the image runs on UTC, so a summer alert names a time
# two hours ago and reads like a notification that arrived late.
# Setting TZ is the fix; bind-mounting /etc/localtime is not.
#TZ=Europe/Amsterdam

# Server log verbosity. The default is our own lines at INFO and nothing from
# the libraries. Per-request logging sits at DEBUG on purpose: Traefik's access
# log already records every request in front of this, and one map page load is
# ~85 frame fetches, so repeating them here would bury the few lines that say
# something. Turn them on when you need them:
#   RUST_LOG=weather_backend=debug,tower_http=debug
#RUST_LOG=weather_backend=info,tower_http=warn

# The hostname Traefik routes to the app. TLS is assumed to be configured on the
# `websecure` entrypoint (a wildcard certificate covering this name); a Traefik
# that issues per-router certificates needs a certresolver label adding.
#BUITJES_HOST=weather.example.nl

# The router's middleware chain, in order. Traefik *replaces* the list rather
# than appending to it, so every middleware the router should have — including
# the rate limiter defined in docker-compose.yml — has to be named here.
#
#   buitjes-ratelimit@docker                     open to the internet
#   sso-auth@docker,buitjes-ratelimit@docker     behind SSO
#   internal-only@docker,buitjes-ratelimit@docker  LAN and VPN only
#
# Auth first, so an unauthenticated visitor is turned away before the app is
# asked for anything. Note that putting this behind SSO also gates the *API*:
# a browser widget on another origin would then get a login page instead of
# JSON, while a dashboard fetching the container directly over the Docker
# network is unaffected — see the CORS note below.
#BUITJES_MIDDLEWARES=buitjes-ratelimit@docker

# --- exposing this on the public internet ---
#
# Be clear-eyed about what each layer does:
#
#   CORS          stops *other websites'* JavaScript from reading your API in a
#                 visitor's browser. It does nothing against curl or a script.
#   API_KEYS      stops casual scraping and lets you revoke access. A key shipped
#                 inside a public homepage widget is readable by anyone who opens
#                 devtools, so treat it as an identifier, not a password.
#   rate limiting is the layer that actually protects the machine. It lives in
#                 Traefik (see the labels in docker-compose.yml) so it applies
#                 before a request reaches the container, and covers the static
#                 frontend and the frame downloads too.
#   volumetric    a real flood saturates the uplink before any of the above sees
#     DDoS        it. That can only be handled upstream - your hosting
#                 provider's protection, or a CDN in front of the domain.
#
# Origins allowed to call the API cross-origin. Unset = same-origin only, which
# is the safe default. "*" restores the old allow-everything behaviour.
#CORS_ALLOWED_ORIGINS=https://home.example.nl

# Comma-separated keys accepted on the widget endpoints, via an X-API-Key header
# or a ?key= query parameter. Empty leaves them open. Listing two lets you roll
# a new key onto the widget before removing the old one.
#   openssl rand -hex 24
#API_KEYS=

# Whatever you set here also gates the *list of saved locations*. /api/config
# stays open, because the map needs its bounds and frame list to draw anything,
# but the `points` array — the names and coordinates from WIDGET_LOCATIONS — is
# served only to a caller presenting a key. The location picker on the forecast
# page appears only for that reader; open it once as
#   https://your.host/forecast.html?key=<one of API_KEYS>
# and the browser remembers the key, stripping it back out of the address bar.
# With API_KEYS empty there is nothing to tell callers apart by, so the manifest
# is served whole — a private single-user setup should not need to invent a key.

# Which paths the key guards. The default covers the widget endpoints only: the
# map's own page needs /api/config and /api/frames, and a key embedded in a
# public page protects nothing anyway. Set to "/api" to lock everything down and
# accept that the browser map then needs a key too.
#
# Note that "/api/point" guards both the named-location endpoint and the ad-hoc
# /api/point?lat=&lon= one — the latter samples the published frames for any
# coordinate, which is what the Android client asks for when it wants a forecast
# for wherever the phone is. Both are prefix matches, so neither can be exposed
# without the other.
#API_KEY_PROTECTED_PREFIXES=/api/point,/api/current

# ----------------------------------------------------------------- alerts
#
# "Tell me when it is about to rain at X." Evaluated in the ingestor each time a
# cycle is published, against the same point forecast the API serves — so a rule
# can only watch a location listed in WIDGET_LOCATIONS above.
#
#   name : [metric@] threshold : lead_minutes [: probability [: quiet_minutes]]
#
# separated by semicolons. Every field after the name may be left empty to take
# its default (the median at 0.5 mm/h, 60 minutes, no probability floor, 60
# minutes quiet).
#
#   ALERT_RULES=home                 rain over 0.5 mm/h within the hour
#   ALERT_RULES=home:2:30            only heavier rain, half an hour ahead
#   ALERT_RULES=home:0.5:60:0.6      and only if 60% of members agree
#   ALERT_RULES=home:1:60; work:1:90 two locations, different lead times
#
# `metric` picks which number the threshold applies to. It defaults to the
# median, which is the right question for steady rain and the wrong one for
# showers: the median is zero unless half the members rain on your exact square
# kilometre, so a shower eight of twenty members drop on your street produces a
# median of zero and an alert that never fires — however you set the
# probability floor, which is a second gate and cannot rescue a threshold that
# was never crossed.
#
#   field                          a rate, in mm/h: the number the map paints
#   median mean p10 p25 p75 p90    a rate, in mm/h, across the members here
#   prob prob_nearby               a fraction of members, 0 to 1
#
# `field` is usually the plainest of these and worth reaching for first. It is
# the number the map draws and the chart draws — a reconstruction placed by the
# ensemble mean rather than a percentile of the twenty values at your own square
# kilometre — so a rule on it fires when the map would show rain on you, and the
# page the alert points at agrees with the alert. It is not the default only
# because changing what a bare rule means would silently change what every
# existing deployment fires on.
#
#   ALERT_RULES=home:field@0.5:60         when the map would paint 0.5 mm/h on
#                                         you within the hour
#   ALERT_RULES=home:p90@0.5:60           when the wet tail of the ensemble
#                                         crosses 0.5 mm/h — early warning,
#                                         and it will cry wolf sometimes
#   ALERT_RULES=home:prob_nearby@0.5:30   when half the members put rain within
#                                         NEIGHBOURHOOD_KM in the next half hour
#   ALERT_RULES=home:prob@0.7:30          the same question about one pixel,
#                                         which for showers is a stricter test
#                                         than the number suggests
#
# An alert fires on the *edge* — rain entering the window — and then stays quiet
# until the window is clearly dry again. See ingestor/alerts.py for why that
# needs three separate mechanisms rather than one.
#ALERT_RULES=

# Where alerts are delivered. A plain webhook, because ntfy, Gotify, Home
# Assistant, Discord and a two-line script all accept one:
#   ntfy      https://ntfy.sh/your-topic          with ALERT_FORMAT=ntfy
#   self-hosted ntfy on the same Docker network: http://ntfy/<topic>. Prefer
#     that over the public hostname — going out and back in sends the alert
#     through your own reverse proxy and whatever WAF sits on it, and a WAF
#     that inspects JSON request bodies can ban the host for talking to itself.
#     ALERT_FORMAT=ntfy also avoids sending a JSON body at all.
#   Gotify    https://gotify.example.nl/message?token=...
#   anything  receives {title, message, location, onset, peak_mm_h, ...}
# Rules without a webhook are still evaluated and logged, which is a useful dry
# run and useless as an alarm.
#ALERT_WEBHOOK_URL=
#ALERT_FORMAT=json
# Sent as the Authorization header — e.g. an ntfy access token.
#ALERT_WEBHOOK_AUTH=Bearer tk_...

# Where the latch state lives. Defaults to alerts.json beside the frames, so a
# restart does not re-announce rain it already announced.
#ALERT_STATE_FILE=/data/alerts.json

# Seconds without a new forecast cycle before that is itself worth an alert,
# with a second one when cycles resume. 0 disables it.
#
# This is the only thing watching for a stalled upstream. The container health
# check deliberately does not: it reads /livez, because an unhealthy container
# is dropped from Traefik's routing table and a KNMI outage must not take the
# site down. See the note on /healthz in the README.
#STALL_ALERT_SECONDS=1800

# Where a stall goes. Deliberately its own webhook, not the rain rules': this
# is news about the pipeline rather than the weather, it usually wants its own
# topic, and it is worth having for someone who configured no rain rules at
# all. Each of the three falls back to its ALERT_* equivalent when unset, so
# one webhook for both is still a matter of leaving these blank.
#
# For an ntfy topic on the same host, address the container over the internal
# network rather than the public name — a notification routed back in through
# your own proxy meets the WAF, and ALERT_FORMAT=ntfy avoids sending a JSON
# body for it to inspect in the first place:
#STALL_WEBHOOK_URL=http://ntfy/alerts
#STALL_ALERT_FORMAT=ntfy
#STALL_WEBHOOK_AUTH=Bearer tk_...
