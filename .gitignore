# Secrets: holds the KNMI Open Data and Notification Service API keys.
# .env.example is the committed template.
.env
.env.local
.env.*.local

# Rust build output
backend/target/

# Python (ingestor)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Downloaded KNMI source data - a single forecast cycle is ~30 MB.
# The ingestor writes these to a scratch dir, but keep them out by accident too.
*.h5
*.nc

# Ingestor output: frames live in a docker volume, never in the repo.
frames/
manifest.json
grid.json
mqtt-client-id

# macOS
.DS_Store
**/.DS_Store

# Nextcloud sync conflict copies ("app 2.js", "main 3.py"). Three of these were
# committed once by a broad `git add`, and an unreadable one blocked a build.
* [0-9].*
*conflicted copy*

# Vendored library sourcemaps (the libraries themselves are committed)
frontend/vendor/**/*.map

# Private notes, deliberately not published. DEPLOYMENT.md is a runbook for one
# specific server — its middleware names, directory layout and container names
# describe that machine — and IMPLEMENTATION_PLAN.md is the working record
# behind it. Neither is needed to run this; .env.example documents every option.
# ANDROID_PLAN.md is the same kind of working record for the android-app branch.
docs/DEPLOYMENT.md
docs/IMPLEMENTATION_PLAN.md
docs/ANDROID_PLAN.md

# Android build output. The app source lives on the android-app branch,
# which has its own android/.gitignore; on master only the residue is left.
android/.gradle/
android/.idea/
android/.kotlin/
android/local.properties
android/**/build/
