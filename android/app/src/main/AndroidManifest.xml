<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Coarse only, and never fine. The server rounds every ad-hoc coordinate to
        hundredths of a degree before it answers, and the radar grid underneath
        is about a kilometre wide, so a precise fix would be thrown away twice
        over before it reached a forecast. Asking for less also makes the
        permission dialog an easy yes, and keeps the build free of Play Services.

        BACKGROUND_LOCATION is separate because the refresh worker runs while
        nobody is looking at the app. Android will not grant it from a dialog on
        API 30+ — the alerts screen explains that and sends people to Settings
        rather than firing a request that silently does nothing.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Buitjes">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Exported because the launcher starts it directly when a widget is
            dropped; it is unusable without the widget id that the launcher puts
            in the intent, so there is nothing here for another app to reach.
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_configure_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.BuitjesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/buitjes_widget_info" />
        </receiver>

        <!--
            MY_PACKAGE_REPLACED matters more than BOOT_COMPLETED does: WorkManager
            restores its own periodic work after a reboot, but an app that was
            force-stopped and then updated comes back with nothing enqueued and
            no reason to enqueue it until somebody opens the app. See BootReceiver.
        -->
        <receiver
            android:name=".work.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
